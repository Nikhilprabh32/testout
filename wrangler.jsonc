{
  // Tells Cloudflare: serve the website files, and send /api/* to api/worker.js
  "name": "testout",
  "main": "api/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Public settings (safe to be on GitHub)
  "vars": {
    "YAHOO_CLIENT_ID": "dj0yJmk9cXlydkRuemM0UE5MJmQ9WVdrOVlrSndSM0Z4WVRJbWNHbzlNQT09JnM9Y29uc3VtZXJzZWNyZXQmc3Y9MCZ4PTMy",
    "SPOTIFY_CLIENT_ID": "PASTE_SPOTIFY_CLIENT_ID_HERE",
    "SETUP_ENABLED": "true"
  },

  // Keeps the secrets you add in Cloudflare when GitHub redeploys
  "keep_vars": true
}
