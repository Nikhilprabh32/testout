{
  // Tells Cloudflare: serve the website files, and send /api/* to api/worker.js
  "name": "testout",
  "main": "api/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // keep the secrets you add in the Cloudflare dashboard when GitHub redeploys
  "keep_vars": true
}
