{
  // Tells Cloudflare: serve the website files, and send /api/* to api/worker.js
  "name": "testout",
  "main": "api/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Storage for the live visitor counter
  "durable_objects": {
    "bindings": [{ "name": "STATS", "class_name": "SiteStats" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteStats"] }],

  // Public settings (safe to be on GitHub)
  "vars": {
    "YAHOO_CLIENT_ID": "PASTE_YAHOO_CLIENT_ID_HERE",
    "SPOTIFY_CLIENT_ID": "PASTE_SPOTIFY_CLIENT_ID_HERE",
    "SETUP_ENABLED": "true"
  },

  // Keeps the secrets you added in Cloudflare when GitHub redeploys
  "keep_vars": true
}
